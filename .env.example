# ==============================================================================
# Lyftr AI - LLM Chatbot with Key Failover and Response Caching
# Environment Configuration Template (.env.example)
# Copy this file to .env and configure your keys
# ==============================================================================

# Comma-separated key pool, at least 2 keys (Key ids are key_1, key_2, ... in this order)
# Example with Gemini and Groq or multiple Gemini keys:
# LLM_API_KEYS=AIzaSyD_GEMINI_KEY_1,gsk_GROQ_KEY_2
LLM_API_KEYS=your_gemini_api_key_1,your_secondary_api_key_2

# LiteLLM model name(s)
# Single model for all keys:
LLM_MODEL=gemini/gemini-2.0-flash
# Or distinct comma-separated models matching LLM_API_KEYS order:
# LLM_MODELS=gemini/gemini-2.0-flash,groq/llama-3.3-70b-versatile

# SQLite database location (Must live in /data inside Docker container)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated allowed CORS origins for deployed frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Enable failover test hook via X-Simulate-Failure header (true / false)
ENABLE_FAILURE_SIMULATION=true

# Frontend API URL (Used by frontend when calling backend)
VITE_API_BASE_URL=http://localhost:8000
